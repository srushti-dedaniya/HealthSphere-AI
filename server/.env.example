# Server port (must match the Vite dev proxy target in client/vite.config.ts)
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (use * for all during development)
CORS_ORIGIN=*

# OTP configuration
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# --- Email delivery (nodemailer) ---
# Leave empty to run in demo mode (OTP is logged to the server console and
# returned in the API response so the client can display it).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HealthSphere AI <no-reply@healthsphere.ai>

# --- SMS delivery ---
# Leave SMS_PROVIDER empty to run in demo mode (OTP is logged to the server
# console). When set to "twilio", the credentials below are used.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
