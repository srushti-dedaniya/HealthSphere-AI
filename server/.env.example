# Server port (must match the Vite dev proxy target in client/vite.config.ts)
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (Prisma)
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthsphere?schema=public
# Supabase example (get the exact string from Dashboard -> Project Settings -> Database -> Connection string -> URI):
# Use sslmode=disable so both the Prisma CLI/Studio and the Node runtime can connect.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=disable

# Comma-separated list of allowed CORS origins (use * for all during development)
CORS_ORIGIN=*

# OTP configuration
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# --- Email delivery (nodemailer) ---
# Leave empty to run in demo mode (OTP is logged to the server console and
# returned in the API response so the client can display it).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HealthSphere AI <no-reply@healthsphere.ai>

# --- SMS delivery ---
# Leave SMS_PROVIDER empty to run in demo mode (OTP is logged to the server
# console). When set to "twilio", the credentials below are used.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=

# --- Google Sign-In (OAuth 2.0) ---
# Leave empty to disable "Continue with Google". Create an OAuth 2.0 Client ID
# (Web application) at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# --- ABDM / NDHM (India HealthID / ABHA) ---
# Leave ABDM_CLIENT_ID empty to run in demo mode (OTP is shown to the client).
# Sandbox credentials from https://sandbox.abdm.gov.in/ (Health Facility onboarding).
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_FACILITY_ID=
